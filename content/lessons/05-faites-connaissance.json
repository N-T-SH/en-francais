        },
        {
          "type": "table",
          "title": "Professions — masculin / féminin",
          "headers": ["Masculin", "Féminin"],
          "rows": [
            ["journaliste", "journaliste"],
            ["écrivain", "écrivaine"],
            ["chanteur", "chanteuse"],
            ["réalisateur", "réalisatrice"],
            ["professeur", "professeure"],
            ["ingénieur", "ingénieure"],
