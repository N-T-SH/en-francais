      "id": "sons-i-e",
      "title": "Les sons [i] et [e]",
      "minutes": 4,
      "lede": "Two vowels that look similar but need different mouth shapes. Both are high and smiling, but [i] is tighter than [e].",
      "blocks": [
        {
          "type": "table",
          "title": "Deux sons",
          "headers": [
            "Son",
            "Description",
            "Exemples"
