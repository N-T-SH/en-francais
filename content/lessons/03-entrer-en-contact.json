            {
              "prompt": "Nous ___ Divya et Sibi.",
              "answers": [
                "nous appelons"
              ]
            },
            {
              "prompt": "Elles ___ Christabel et Nivedha.",
              "answers": [
                "s'appellent"
              ]
            }
          ]
        }
      ]
    },
    {
