      "id": "s-appeler",
      "title": "S'appeler & prononciation",
      "minutes": 5,
      "lede": "Le verbe réflexif « s'appeler », et deux règles de prononciation à connaître par cœur.",
      "blocks": [
        {
          "type": "table",
          "title": "Conjugaison : s'appeler",
          "headers": [
            "Sujet",
            "Forme"
          ],
          "rows": [
            [
              "Je",
              "m'appelle"
            ],
            [
              "Tu",
              "t'appelles"
            ],
            [
              "Il / Elle",
              "s'appelle"
            ],
            [
              "Nous",
              "nous appelons"
            ],
            [
              "Vous",
              "vous appelez"
            ],
            [
              "Ils / Elles",
              "s'appellent"
            ]
          ]
        },
        {
          "type": "phrases",
          "title": "Prononciation — écoutez la différence",
          "note": "-ER, -EZ, é → se prononcent « é ». -ES, -E, -ENT → silencieuses.",
          "items": [
            {
              "fr": "café",
              "en": "é sonore"
            },
            {
              "fr": "Vous allez bien ?",
              "en": "-ez sonore"
            },
            {
              "fr": "parler",
              "en": "-er sonore"
            },
            {
              "fr": "téléphone",
              "en": "e final muet"
            },
            {
              "fr": "Ils s'appellent Neeraj et Raman.",
              "label": "Ils s'appellent…",
              "en": "-ent muet"
            }
          ]
        },
        {
          "type": "exercise",
          "title": "Conjuguez s'appeler",
          "items": [
            {
              "prompt": "Tu ___ comment ?",
              "answers": [
                "t'appelles"
