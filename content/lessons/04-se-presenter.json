      "title": "S'appeler & prononciation",
      "minutes": 5,
      "lede": "Le verbe réflexif « s'appeler », et deux règles de prononciation à connaître par cœur.",
      "blocks": [
        {
          "type": "table",
          "title": "Conjugaison : s'appeler",
          "headers": [
            "Sujet",
            "Forme"
