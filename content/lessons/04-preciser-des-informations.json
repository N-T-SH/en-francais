      "minutes": 7,
      "lede": "Le vocabulaire d'un site de réservation, et les questions pour réserver une chambre.",
      "blocks": [
        {
          "type": "phrases",
          "title": "Écoutez et répétez",
          "items": [
            { "fr": "Vous avez une chambre simple ?" },
