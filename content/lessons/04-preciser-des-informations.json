            { "fr": "Quelle chambre vous réservez ?" },
            { "fr": "Vous avez une chambre disponible pour deux nuits ?" },
            { "fr": "Quelle est l'heure d'arrivée ?" },
            { "fr": "Quel est le prix du week-end pour deux personnes ?" },
            { "fr": "Combien d'enfants vous avez ?" },
            { "fr": "Quelle est l'heure de départ ?" },
            { "fr": "Pour combien de personnes ?" },
            { "fr": "Combien de chambres sont disponibles ?" },
            { "fr": "Quel est votre numéro de téléphone ?" },
            { "fr": "Quelle chambre vous préférez ?" }
          ]
        },
        {
          "type": "task",
          "title": "Jeu de rôle : réserver une chambre",
          "mode": "oral",
          "prompt": "À deux (client / hôtel), ou seul à voix haute : réservez une chambre double pour 2 nuits, ce week-end, pour 2 personnes. Utilisez au moins 5 des questions ci-dessus."
        }
      ]
    },
    {
      "id": "phonetique",
      "title": "Phonétique",
      "minutes": 7,
      "lede": "Quatre sons à distinguer, plus la règle des lettres finales muettes et des liaisons.",
      "blocks": [
        {
          "type": "phrases",
          "title": "IN / AN — TION / SION",
          "items": [
            { "fr": "information" },
            { "fr": "indien" },
            { "fr": "institut" },
            { "fr": "institution" }
          ]
        },
        {
          "type": "phrases",
          "title": "OU / AU",
          "items": [
            { "fr": "août" },
            { "fr": "courriel" },
            { "fr": "auteur" },
            { "fr": "autobus" },
            { "fr": "automatique" }
          ]
        },
        {
          "type": "phrases",
          "title": "Liaisons",
          "note": "Règle générale : on ne prononce pas la dernière consonne. Exception : les liaisons.",
          "items": [
            { "fr": "Nous avons", "en": "liaison : s → z" },
            { "fr": "Nous parlons", "en": "pas de liaison" }
          ]
        },
        {
          "type": "task",
          "title": "Répétez à voix haute",
          "mode": "oral",
          "prompt": "Lisez ces deux phrases en faisant la liaison quand il faut : « Nous avons deux enfants. » / « Nous parlons français. »",
          "model": "Nou-z-avons deu-z-enfants. / Nous parlons français (pas de liaison)."
        }
      ]
